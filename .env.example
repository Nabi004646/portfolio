# Public browser configuration. Never put a secret/service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Optional bot protection for contact and visitor-demo submissions.
VITE_TURNSTILE_SITE_KEY=
# Build-only public URL. Use your real HTTPS domain before enabling indexing.
PUBLIC_SITE_URL=http://localhost:4173
VITE_SITE_URL=http://localhost:4173
SEO_INDEXABLE=false
# Optional additional HTTPS image origins, comma-separated hostnames only.
IMAGE_SOURCE_HOSTS=
