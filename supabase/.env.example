# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by hosted Supabase.
# For local functions, set your local equivalents. Never put these in VITE_*.
RESEND_API_KEY=re_REPLACE_IN_SUPABASE_SECRETS
MAIL_FROM=Nabin Portfolio <portfolio@your-verified-domain.example>
OWNER_EMAIL=nabinkunwar992@gmail.com
# Exact comma-separated origins. Do not use '*' or a path.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Generate locally with: openssl rand -hex 32
IP_HASH_SECRET=REPLACE_WITH_A_RANDOM_SERVER_ONLY_SECRET
# Recommended for any internet-accessible deployment. Use false only locally.
REQUIRE_TURNSTILE=true
TURNSTILE_SECRET_KEY=REPLACE_IF_ENABLED
# Hostnames allowed in verified Turnstile tokens, comma-separated.
TURNSTILE_HOSTNAMES=localhost
# Server-only deployment trigger. Never put either value in VITE_*.
CLOUDFLARE_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/REPLACE_PRIVATELY
PUBLISH_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SERVER_ONLY_SECRET
